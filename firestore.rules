rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Services: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      
      // Admins can create/delete/update anything
      allow create, delete: if request.auth != null && request.auth.token.admin == true;
      
      // Update logic: Admin OR regular user updating specific fields
      allow update: if request.auth != null && (
        request.auth.token.admin == true || 
        (
           // Allow regular users to update ONLY these specific fields for likes
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recommendations', 'recentRecommenders', 'lastRecommended'])
        )
      );
      
      // Allow users to manage their own recommendation in the subcollection, or admins
      match /recommendations/{userId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      }
    }
    
    // Allow collection group queries on recommendations
    match /{path=**}/recommendations/{recId} {
      allow read: if true;
    }

    // Suggested Services: Authenticated users create, Admin read/write
    match /suggested_services/{suggestionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Config: Public read, Admin write
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow clients to read the list of requests
    match /requests/{requestId} {
      allow read: if true;
      allow write: if false; // Writes should only come from the backend
    }

    // Public Profiles: Read-only for everyone, Write only by backend (Cloud Functions)
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if false; 
    }

    // Allow users to read and write their own profile, Admins can read/write any profile
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        (
            request.auth.uid == userId && 
            (
                // Allow if not setting the field at all
                !('sunnyBetaStatus' in request.resource.data) ||
                // Allow if setting to pending
                request.resource.data.sunnyBetaStatus == 'pending' ||
                // Allow if maintaining existing status (e.g. approved user updating profile)
                (resource != null && request.resource.data.sunnyBetaStatus == resource.data.sunnyBetaStatus)
            )
        )
      );
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
