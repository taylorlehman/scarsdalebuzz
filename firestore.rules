rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Services: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      
      // Admins can create/delete/update anything
      allow create, delete: if request.auth != null && request.auth.token.admin == true;
      
      // Update logic: Admin OR regular user updating specific fields
      allow update: if request.auth != null && (
        request.auth.token.admin == true || 
        (
           // Allow regular users to update ONLY these specific fields for likes
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recommendations', 'recentRecommenders', 'lastRecommended'])
        )
      );
      
      // Allow users to manage their own recommendation in the subcollection
      match /recommendations/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Config: Public read, Admin write
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow clients to read the list of requests
    match /requests/{requestId} {
      allow read: if true;
      allow write: if false; // Writes should only come from the backend
    }

    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
