rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Services: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
      
      // Allow users to manage their own recommendation in the subcollection
      match /recommendations/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Config: Public read, Admin write
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow clients to read the list of requests
    match /requests/{requestId} {
      allow read: if true;
      allow write: if false; // Writes should only come from the backend
    }

    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
